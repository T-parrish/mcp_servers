# Environment configuration for bandcamp_mcp_server.
# Copy to `.env` (which is gitignored) and adjust. Loaded on startup from the
# working directory; real environment variables take precedence over these.

# Logging verbosity: error | warn | info | debug | trace
RUST_LOG=info

# --- Rate limiting (see README > Rate limiting) ---
BANDCAMP_MAX_CONCURRENT_REQUESTS=1
BANDCAMP_MIN_REQUEST_INTERVAL_MS=750

# --- Cart / authentication (optional; see README > Cart & authentication) ---
# Enable live cart writes; otherwise add_to_cart is a dry run:
# BANDCAMP_ALLOW_CART_WRITES=1

# Session cookie. Prefer the `authenticate` tool (esp. from_browser) over pasting
# it here. Quote it — it contains ';' and spaces. Keep this file secret.
# BANDCAMP_COOKIE="identity=...; session=..."

# Override where the cookie is cached (default: ~/.config/bandcamp_mcp_server/cookie):
# BANDCAMP_COOKIE_FILE=/absolute/path/to/cookie
