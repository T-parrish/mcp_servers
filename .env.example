# Workspace-wide environment configuration, shared by every MCP server here.
# Copy to `.env` (which is gitignored) and adjust. Loaded on startup from the
# working directory, searching parents — so it is found whether you run from the
# root or from a member crate. Real environment variables take precedence.

# Logging verbosity: error | warn | info | debug | trace
RUST_LOG=info

# --- OpenTelemetry (optional; see each server's README > OpenTelemetry export) ---
# Applies to every server. Setting an OTLP endpoint enables span + metric export;
# unset means export is off. This is what the root `docker compose up -d` listens on:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# How often metrics are exported, in ms (default 60000):
# OTEL_METRIC_EXPORT_INTERVAL=15000
# `OTEL_SERVICE_NAME` is deliberately absent: one value cannot name two services,
# so each binary defaults it to its own name (bandcamp-mcp / spotify-mcp). Set it
# only to override for a one-off run of a single server.
# To split the signals across backends, use the per-signal variables instead.
# Unlike the shared one above these are used as-is, so the path is required:
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces

# ============================ bandcamp_mcp_server ============================

# --- Rate limiting (see bandcamp_mcp_server/README.md > Rate limiting) ---
BANDCAMP_MAX_CONCURRENT_REQUESTS=1
BANDCAMP_MIN_REQUEST_INTERVAL_MS=750

# --- Cart / authentication (optional; see README > Cart & authentication) ---
# Enable live cart writes; otherwise add_to_cart is a dry run:
# BANDCAMP_ALLOW_CART_WRITES=1

# Session cookie. Prefer the `authenticate` tool (esp. from_browser) over pasting
# it here. Quote it — it contains ';' and spaces. Keep this file secret.
# BANDCAMP_COOKIE="identity=...; session=..."

# Override where the cookie is cached (default: ~/.config/bandcamp_mcp_server/cookie):
# BANDCAMP_COOKIE_FILE=/absolute/path/to/cookie

# ============================ spotify_mcp_server =============================

# --- Spotify application (see spotify_mcp_server/README.md > Authentication) ---
# From https://developer.spotify.com/dashboard. Required for the `authenticate`
# tool; no client secret is needed (the flow uses PKCE).
# SPOTIFY_CLIENT_ID=your_app_client_id

# Loopback URI the authorization redirect comes back to. Must be registered on
# the app *exactly* as written here. Default:
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Override where the OAuth tokens are cached
# (default: ~/.config/spotify_mcp_server/token.json). Keep this file secret.
# SPOTIFY_TOKEN_FILE=/absolute/path/to/token.json

# --- Rate limiting (see spotify_mcp_server/README.md > Rate limiting) ---
SPOTIFY_MAX_CONCURRENT_REQUESTS=4
SPOTIFY_MIN_REQUEST_INTERVAL_MS=100
