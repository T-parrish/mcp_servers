{
  "defaultMode": "auto",
  "permissions": {
    "allow": [
      "Read",
      "Update(*)",
      "Write(*)",
      "Edit(/src/**)",
      "Bash(sed *)",
      "Bash(cargo build *)",
      "Bash(cargo add *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "deny": [
      "Bash(cargo publish *)",
      "Bash(git push *)",
      "Bash(rm *)",
      "Bash(sudo *)"
    ]
  }
}